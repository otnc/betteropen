{
  "name": "betteropen",
  "version": "0.0.0",
  "description": "Better and more convenient \"open\"",
  "keywords": [
    "app",
    "open",
    "opener",
    "opens",
    "launch",
    "start",
    "xdg-open",
    "xdg",
    "default",
    "cmd",
    "browser",
    "editor",
    "executable",
    "exe",
    "url",
    "urls",
    "arguments",
    "args",
    "spawn",
    "exec",
    "child",
    "process",
    "website",
    "file",
    "open-cli",
    "cli"
  ],
  "homepage": "https://github.com/otnc/betteropen#readme",
  "bugs": {
    "url": "https://github.com/otnc/betteropen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/betteropen.git"
  },
  "license": "MIT",
  "author": "otoneko.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "xdg-open"
  ],
  "bin": {
    "betteropen": "./dist/cli.js",
    "open": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check": "biome check --write",
    "ci": "biome ci",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "magic-bytes.js": "^1.13.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
